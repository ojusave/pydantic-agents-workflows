# Synthetic tests use placeholders and never contact either model provider.
OPENAI_API_KEY=local-test-placeholder
ANTHROPIC_API_KEY=local-test-placeholder
# Keep test traces on this computer.
LOGFIRE_TOKEN=
# Replace YOUR_LOCAL_POSTGRES_USER with the account that created the test database.
DATABASE_URL=postgresql://YOUR_LOCAL_POSTGRES_USER@127.0.0.1:55437/pydantic_demo_test
ENVIRONMENT=development
# Both the gateway and child-task clients use the local Render server.
RENDER_USE_LOCAL_DEV=true
RENDER_LOCAL_DEV_URL=http://127.0.0.1:8127
WORKFLOW_SLUG=local
